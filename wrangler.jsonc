{
  "name": "jm-studio-auth",
  "main": "tools/oauth-worker.js",
  "compatibility_date": "2026-07-13",
  "workers_dev": true,
  "vars": {
    "EMAIL_FROM": "Jaemin Choi <onboarding@resend.dev>"
  },
  // Wakes the Pages workflow's due check for scheduled posts each hour (see
  // dispatchDueCheck in tools/oauth-worker.js; needs the GH_DISPATCH_TOKEN secret).
  "triggers": {
    "crons": ["2 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SUBSCRIBERS",
      "id": "c7d033b576e74126960a6c4e839e5a56"
    }
  ]
}
